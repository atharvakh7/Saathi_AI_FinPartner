# Saathi backend configuration (spec §9.1). Copy to backend/.env and fill in secrets.
# NO real secrets in this file.
#
# Generate secrets:
#   JWT_SECRET / OTP_HMAC_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   DATA_ENCRYPTION_KEY:        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The API refuses to start if JWT_SECRET, DATA_ENCRYPTION_KEY or OTP_HMAC_KEY is missing or < 32 chars (spec §8.3).

# --- App ---
APP_ENV=local
API_BASE_URL=http://localhost:8000
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=
GRIEVANCE_EMAIL=grievance@example.com
# Your own phone (+91 followed by 10 digits starting 6-9). Blank = no admin user is seeded.
ADMIN_PHONE_E164=

# --- Database / cache ---
# Hostnames assume the API runs on the host machine against docker-compose.dev.yml ports.
# If the API runs inside the compose network, use postgres / redis / minio / ollama as hostnames.
POSTGRES_USER=saathi
POSTGRES_PASSWORD=saathi
POSTGRES_DB=saathi
DATABASE_URL=postgresql+asyncpg://saathi:saathi@localhost:5432/saathi
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30
DATA_ENCRYPTION_KEY=
OTP_HMAC_KEY=
# console = OTP code is logged at INFO level (dev only); msg91 = real SMS via DLT-registered template
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# --- Rate limits ---
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_IP_PER_MIN=300

# --- LLM (any OpenAI-compatible endpoint; default = local Ollama) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma4:e4b-it-qat
LLM_API_KEY=ollama
LLM_TIMEOUT_SEC=60
LLM_MAX_CONCURRENCY=2
# reasoning_effort sent to the LLM; "none" disables thinking in reasoning models. Blank = omit.
LLM_REASONING_EFFORT=none

# --- Embeddings ---
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024

# --- Speech-to-text (whisper.cpp) ---
# Download e.g. ggml-small.bin into backend/ml_models/whisper/ (small recommended for hi/mr/ta)
WHISPER_MODEL_PATH=./ml_models/whisper/ggml-small.bin
# Roughly 3/4 of your logical CPU cores; 12 on a 16-thread laptop cut latency from ~11 s to ~4 s.
WHISPER_THREADS=4
# Whisper small decodes Marathi better with its Hindi decoder (42% vs 73% CER). Set mr to use the native one.
WHISPER_MR_DECODE_AS=hi

# --- Text-to-speech (Piper .onnx voice paths; blank = unavailable -> app uses on-device TTS) ---
# Piper has voices for en/hi/mr but none for Tamil (spec A8). See backend/ml_models/README.md for sources/licences.
PIPER_VOICE_EN=./ml_models/piper/en_US-lessac-medium.onnx
PIPER_VOICE_HI=./ml_models/piper/hi_IN-pratham-medium.onnx
PIPER_VOICE_MR=./ml_models/piper/mr_IN-google-medium.onnx
PIPER_VOICE_TA=

# --- OCR (Tesseract 5 with eng, hin, mar, tam traineddata) ---
# Windows: C:/Program Files/Tesseract-OCR/tesseract.exe   Linux: /usr/bin/tesseract
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSDATA_PREFIX=./ml_models/tessdata

# --- Scam classifier (fine-tuned DistilBERT dir; blank disables, rules engine still works) ---
SCAM_MODEL_DIR=

# --- Audio conversion (blank = ffmpeg bundled with the imageio-ffmpeg package) ---
FFMPEG_CMD=

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=saathi-minio
S3_SECRET_KEY=saathi-minio-secret
S3_BUCKET_MEDIA=saathi-media
S3_BUCKET_TTS=saathi-tts-cache
S3_REGION=ap-south-1

# --- Push notifications ---
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
