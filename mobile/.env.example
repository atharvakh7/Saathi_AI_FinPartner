# Saathi mobile configuration (spec §9.2). Copy to mobile/.env.
# Android emulator reaches the host machine at 10.0.2.2; a physical phone needs your PC's LAN IP.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
EXPO_PUBLIC_GRIEVANCE_EMAIL=grievance@example.com
# Required to obtain Expo push tokens (create a project with `npx eas init`).
EXPO_PUBLIC_EAS_PROJECT_ID=
